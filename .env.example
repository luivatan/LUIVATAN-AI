# Copy this file to .env and fill in the values you need.
# .env is loaded automatically on startup (see ingest.py) and is gitignored,
# so real secrets never need to be committed.

# Which LLM backend to use: llama_cpp | ollama | openai | openai_compatible | transformers
LLM_PROVIDER=llama_cpp

# --- llama_cpp provider ---
# Optional: preselect a local GGUF model file instead of choosing one in the UI.
LLAMA_MODEL_PATH=
LLM_CONTEXT_SIZE=2048

# --- ollama provider ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# --- openai / openai_compatible provider ---
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- transformers provider ---
HF_MODEL_PATH=Qwen/Qwen2.5-0.5B-Instruct

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
