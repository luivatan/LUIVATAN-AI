# Apex AI configuration
# Copy this file to `.env` and edit. NEVER commit your real .env.
# Every value has a sensible default; everything works offline once models
# are downloaded. Old LLM_PROVIDER / LLAMA_MODEL_PATH / OLLAMA_* / OPENAI_*
# variable names are still honored for compatibility.

# --- LLM ---------------------------------------------------------------
# Provider: llama_cpp | ollama | openai | openai_compatible | transformers
APEX_LLM_PROVIDER=llama_cpp

# Exact model file. Leave empty to pick a model in the Models tab instead.
# APEX_MODEL_PATH=/absolute/path/to/model.gguf

# Directory scanned by the model manager (Models tab / scripts/list_models.py)
APEX_MODEL_DIR=models

# llama.cpp context window and GPU offload (0 = CPU only, -1 = all layers)
APEX_LLM_CONTEXT_SIZE=4096
APEX_N_GPU_LAYERS=0
# APEX_N_THREADS=4

# --- Ollama provider (APEX_LLM_PROVIDER=ollama) -------------------------
APEX_OLLAMA_URL=http://127.0.0.1:11434
APEX_OLLAMA_MODEL=qwen2.5-coder:7b

# --- OpenAI-compatible provider (openai / openai_compatible) ------------
# API keys live ONLY here or in your environment — never in git.
# APEX_OPENAI_API_KEY=sk-...
# APEX_OPENAI_API_BASE=https://api.openai.com/v1
APEX_OPENAI_MODEL=gpt-4.1-mini

# --- Transformers provider (APEX_LLM_PROVIDER=transformers) -------------
APEX_HF_MODEL_PATH=Qwen/Qwen2.5-0.5B-Instruct

# --- Embeddings (independent from the generation LLM) --------------------
APEX_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Retrieval / RAG tuning ----------------------------------------------
# Fused candidate pool, per-query channel pools, and final evidence chunks
APEX_TOP_K=12
APEX_SEMANTIC_CANDIDATES=16
APEX_KEYWORD_CANDIDATES=16
APEX_RERANK_TOP_K=4
# Weighted Reciprocal Rank Fusion (weights need not sum exactly to 1)
APEX_VECTOR_WEIGHT=0.6
APEX_KEYWORD_WEIGHT=0.4
APEX_RRF_K=60
# Evidence gates: cosine threshold plus conservative exact/lexical fallback
APEX_MIN_SIMILARITY=0.30
APEX_LEXICAL_SUPPORT_THRESHOLD=0.60
# Reranker: auto | cross_encoder | lexical | off
APEX_RERANKER=auto
# APEX_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Conservative deterministic follow-up/decomposition is automatic. Optional
# LLM rewriting is separately off by default because it adds a model call.
APEX_QUERY_PROCESSING=1
APEX_QUERY_DECOMPOSITION=1
APEX_MAX_QUERY_VARIANTS=4
APEX_QUERY_REWRITE=0
# Evidence budget and token reserve for instructions/history/output
APEX_CONTEXT_CHAR_LIMIT=6000
APEX_CONTEXT_TOKEN_RESERVE=1024
# Short-term conversation context. MEMORY_TURNS bounds recent retrieval/legacy
# storage; the smaller HISTORY limits bound exactly what one model turn receives.
APEX_MEMORY_TURNS=8
APEX_HISTORY_TURNS=3
APEX_HISTORY_CHAR_LIMIT=2400
APEX_HISTORY_MESSAGE_CHAR_LIMIT=1000
# Medical-safety addendum in prompts (recommended when using medical documents)
APEX_MEDICAL_MODE=1

# --- Chunking -------------------------------------------------------------
APEX_CHUNK_SIZE=1000
APEX_CHUNK_OVERLAP=150
APEX_MIN_CHUNK_SIZE=200
APEX_MAX_CHUNK_SIZE=1600

# --- Storage (relative paths resolve from the project root) ---------------
APEX_DATABASE_PATH=data/chroma
APEX_UPLOAD_DIR=data/uploads
APEX_MEMORY_PATH=data/conversation_memory.json
# Multi-conversation history used by the chat-first web interface
APEX_CONVERSATION_DB_PATH=data/conversations.db
APEX_LOG_DIR=logs
APEX_CACHE_DIR=data/cache

# --- Offline mode ----------------------------------------------------------
# 1 = never download anything (fails with a clear message if a model is missing)
APEX_OFFLINE=0

# --- Server ------------------------------------------------------------------
APEX_SERVER_NAME=0.0.0.0
APEX_SERVER_PORT=7860
# Developer-only POST /debug/rag (route absent, unlinked, and undocumented when off)
APEX_RAG_DEBUG=0
