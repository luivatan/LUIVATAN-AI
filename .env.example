# Apex AI configuration
# Copy this file to `.env` and edit. NEVER commit your real .env.
# Local providers can work offline once their model artifacts are cached.
# Remote providers still require their configured endpoint. Old LLM_PROVIDER /
# LLAMA_MODEL_PATH / OLLAMA_* / OPENAI_* names remain supported for compatibility.

# --- LLM ---------------------------------------------------------------
# Provider: llama_cpp | ollama | openai | openai_compatible | transformers
# llama_cpp is fully local. OpenAI-compatible providers receive the question,
# bounded conversation context, and retrieved evidence at the configured URL.
APEX_LLM_PROVIDER=llama_cpp

# Exact model file. Leave empty to pick a model in the Models tab instead.
# APEX_MODEL_PATH=

# Directory scanned by the model manager (Models tab / scripts/list_models.py)
APEX_MODEL_DIR=models

# llama.cpp context window and GPU offload (0 = CPU only, -1 = all layers)
APEX_LLM_CONTEXT_SIZE=4096
APEX_N_GPU_LAYERS=0
# APEX_N_THREADS=4

# --- Ollama provider (APEX_LLM_PROVIDER=ollama) -------------------------
APEX_OLLAMA_URL=http://127.0.0.1:11434
APEX_OLLAMA_MODEL=qwen2.5-coder:7b

# --- OpenAI-compatible provider (openai / openai_compatible) ------------
# API keys live ONLY in your untracked .env or deployment secret store — never in git.
# APEX_OPENAI_API_KEY=
# APEX_OPENAI_API_BASE=https://api.openai.com/v1
APEX_OPENAI_MODEL=gpt-4.1-mini

# HTTP provider connect/read timeouts in seconds (Ollama and OpenAI-compatible)
APEX_PROVIDER_CONNECT_TIMEOUT_SECONDS=5
APEX_PROVIDER_READ_TIMEOUT_SECONDS=300

# --- Transformers provider (APEX_LLM_PROVIDER=transformers) -------------
APEX_HF_MODEL_PATH=Qwen/Qwen2.5-0.5B-Instruct

# --- Embeddings (independent from the generation LLM) --------------------
APEX_EMBEDDING_MODEL=all-MiniLM-L6-v2
APEX_EMBEDDING_BATCH_SIZE=32

# --- Retrieval / RAG tuning ----------------------------------------------
# Fused candidate pool, per-query channel pools, and final evidence chunks
APEX_TOP_K=12
APEX_SEMANTIC_CANDIDATES=16
APEX_KEYWORD_CANDIDATES=16
APEX_RERANK_TOP_K=4
# Weighted Reciprocal Rank Fusion (weights need not sum exactly to 1)
APEX_VECTOR_WEIGHT=0.6
APEX_KEYWORD_WEIGHT=0.4
APEX_RRF_K=60
# Evidence gates: cosine threshold plus conservative exact/lexical fallback
APEX_MIN_SIMILARITY=0.30
APEX_LEXICAL_SUPPORT_THRESHOLD=0.60
# Reranker: auto | cross_encoder | lexical | off
APEX_RERANKER=auto
# APEX_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Conservative deterministic follow-up/decomposition is automatic. Optional
# LLM rewriting is separately off by default because it adds a model call.
APEX_QUERY_PROCESSING=1
APEX_QUERY_DECOMPOSITION=1
APEX_MAX_QUERY_VARIANTS=4
APEX_QUERY_REWRITE=0
# Evidence budget and token reserve for instructions/history/output
APEX_CONTEXT_CHAR_LIMIT=6000
APEX_CONTEXT_TOKEN_RESERVE=1024
# Answer-generation controls. Query rewrite/decomposition retain separate,
# conservative internal limits so these values cannot inflate retrieval prompts.
APEX_GENERATION_MAX_TOKENS=768
APEX_GENERATION_TEMPERATURE=0.2
# Short-term conversation context. MEMORY_TURNS bounds recent retrieval/legacy
# storage; the smaller HISTORY limits bound exactly what one model turn receives.
APEX_MEMORY_TURNS=8
APEX_HISTORY_TURNS=3
APEX_HISTORY_CHAR_LIMIT=2400
APEX_HISTORY_MESSAGE_CHAR_LIMIT=1000
# Phase 47: inject relevance-filtered CONFIRMED long-term memory (explicit
# preferences/context a user approved with "Remember") into the prompt as a
# clearly separated, never-cited "User context" block. Set 0 to disable even
# when memory exists; this is independent of the per-request "use memory" toggle,
# which must also be on. With a remote provider (Ollama/OpenAI-compatible), this
# content leaves the local process the same way retrieved evidence already does.
APEX_MEMORY_PROMPT_USE=1
# Phase 50: fold turns that fall out of the live short-term window into a
# rolling per-conversation summary (stored in conversations.db), instead of
# letting them silently disappear. Off by default: it costs one extra LLM
# call on the turns where enough new messages have accumulated since the
# last summary (same latency tradeoff APEX_QUERY_REWRITE above already accepts).
APEX_CONVERSATION_SUMMARY=0
# Medical-safety addendum in prompts (recommended when using medical documents)
APEX_MEDICAL_MODE=1

# --- Chunking -------------------------------------------------------------
APEX_CHUNK_SIZE=1000
APEX_CHUNK_OVERLAP=150
APEX_MIN_CHUNK_SIZE=200
APEX_MAX_CHUNK_SIZE=1600

# --- Storage (relative paths resolve from the project root) ---------------
APEX_DATABASE_PATH=data/chroma
APEX_COLLECTION=apex_docs
APEX_UPLOAD_DIR=data/uploads
APEX_MEMORY_PATH=data/conversation_memory.json
# Multi-conversation history used by the chat-first web interface
APEX_CONVERSATION_DB_PATH=data/conversations.db
# Separate Phase 42 store; relevance-filtered confirmed memory reaches prompts
# only when APEX_MEMORY_PROMPT_USE=1 (default) and a request's use_memory is on.
APEX_LONG_TERM_MEMORY_DB_PATH=data/long_term_memory.db
# Phase 51/52: accounts + sessions (users and sessions tables share this file).
APEX_USERS_DB_PATH=data/users.db
# Phase 66: named document-collection labels (membership itself lives in the
# document registry, not here).
APEX_COLLECTIONS_DB_PATH=data/collections.db
# Rotating JSON Lines file logs; console logs remain human-readable.
APEX_LOG_DIR=logs
APEX_CACHE_DIR=data/cache

# Browser multipart upload limit per file. Local-path/batch ingestion is separate.
APEX_MAX_UPLOAD_MB=50

# --- Offline model-cache policy --------------------------------------------
# 1 = never download Hugging Face embedding/reranker/Transformers artifacts.
# This does not override an explicitly configured Ollama/OpenAI-compatible URL;
# use a local provider and network controls when a complete air gap is required.
APEX_OFFLINE=0

# --- Server ------------------------------------------------------------------
# Loopback is the safe default. Set 0.0.0.0 only for a deliberately protected
# deployment/network boundary, with APEX_AUTO_LOGIN_LOCAL=0 below so real
# accounts are actually required (loopback + a wider bind are two different
# concerns now that Phase 51/52 accounts exist).
APEX_SERVER_NAME=127.0.0.1
APEX_SERVER_PORT=7860
# Developer-only POST /debug/rag (route absent, unlinked, and undocumented when off)
APEX_RAG_DEBUG=0

# --- Accounts / sessions (Phase 51/52) ----------------------------------------
APEX_SESSION_COOKIE_NAME=apex_session
APEX_SESSION_TTL_DAYS=30
# 1 (default): an unauthenticated request is transparently treated as the
# auto-provisioned default local account - so a single machine running Apex AI
# for one person needs no login screen. An explicit login for a different real
# account still takes precedence. Set 0 to require real login for every
# request (a shared/hosted deployment with multiple real accounts).
APEX_AUTO_LOGIN_LOCAL=1

# --- API security (Phase 58) --------------------------------------------------
# In-memory, per-client-IP sliding window; resets on restart. 0 disables it
# entirely (for example to defer rate limiting to a reverse proxy instead).
APEX_RATE_LIMIT_ENABLED=1
APEX_RATE_LIMIT_PER_MINUTE=120
# Stricter budget for /auth/login and /auth/signup - the classic brute-force /
# credential-stuffing target.
APEX_AUTH_RATE_LIMIT_PER_MINUTE=10
# Comma-separated allowed origins for cross-origin browser requests. Empty
# (default) means no CORS headers at all - correct for the bundled same-origin
# web app. Only set this if a separately-hosted frontend calls this API.
APEX_CORS_ALLOWED_ORIGINS=
